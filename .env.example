# ─────────────────────────────────────────────────────────────────────────────
# Sweetilo — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# The .gitignore in this repo already excludes all .env* files.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "production" in prod, "development" locally.
NODE_ENV=development

# Public site URL (used for canonical links, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=https://sweetilo.com

# ── WhatsApp Integration ──────────────────────────────────────────────────────
# The Baker's WhatsApp number in international format (no +, no spaces).
# This is intentionally a NEXT_PUBLIC_ variable — it appears in HTML source.
NEXT_PUBLIC_WHATSAPP_NUMBER=923008457933

# ── Backend / API (if a backend is added in future) ──────────────────────────
# These must NOT be NEXT_PUBLIC_ — they are server-side only.
# API_SECRET_KEY=replace_with_minimum_256_bit_random_secret
# DATABASE_URL=replace_with_your_database_connection_string

# ── Future: Webhook signing secret ───────────────────────────────────────────
# Used to verify HMAC-SHA256 signatures on incoming webhook payloads.
# Must be at least 32 bytes of random data (generate with: openssl rand -hex 32)
# WEBHOOK_SIGNING_SECRET=replace_with_openssl_rand_hex_32_output
